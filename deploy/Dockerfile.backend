# Image backend EdgeBet (API + worker). Construite depuis la racine du dépôt :
#   docker build -f deploy/Dockerfile.backend -t edgebet-backend .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Europe/Paris \
    EDGEBET_DATA_DIR=/app/data

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl tzdata libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/pyproject.toml backend/README.md ./
COPY backend/edgebet ./edgebet
RUN pip install --no-cache-dir .

VOLUME ["/app/data"]
EXPOSE 8000
HEALTHCHECK --interval=60s --timeout=5s --start-period=20s CMD curl -fsS http://localhost:8000/api/health || exit 1
CMD ["edgebet", "serve", "--host", "0.0.0.0", "--port", "8000"]
