# ---------- EdgeBet : configuration (copier en deploy/.env) ----------
# Toutes les variables sont préfixées EDGEBET_. Les listes sont séparées par des virgules.

# Périmètre : codes football-data.co.uk (F1 Ligue 1, F2 Ligue 2, E0 Premier League, SP1 La Liga, D1 Bundesliga, I1 Serie A)
EDGEBET_LEAGUES=F1,F2,E0,SP1,D1,I1
EDGEBET_SEASONS_BACK=12

# Bookmakers comparés (clés The Odds API) et bookmaker de référence
EDGEBET_BOOKMAKERS=winamax_fr,unibet_fr,betclic
EDGEBET_SHARP_BOOKMAKER=pinnacle
EDGEBET_ODDS_REGIONS=eu,fr
EDGEBET_ODDS_MARKETS=h2h

# Clés API (obligatoire : The Odds API ; optionnel : API-Football)
EDGEBET_ODDS_API_KEY=
EDGEBET_API_FOOTBALL_KEY=

# Telegram : jeton du bot (BotFather) et identifiant du chat (ton compte ou un groupe)
EDGEBET_TELEGRAM_BOT_TOKEN=
EDGEBET_TELEGRAM_CHAT_ID=

# Clé protégeant les endpoints d'écriture de l'API (à saisir aussi dans la PWA et dans n8n)
EDGEBET_API_KEY=change-moi

# Bankroll et politique de mise
EDGEBET_BANKROLL=100
EDGEBET_KELLY_FRACTION=0.25
EDGEBET_MAX_STAKE_FRACTION=0.05
EDGEBET_MIN_EDGE=0.03
EDGEBET_MIN_ODDS=1.30
EDGEBET_MAX_ODDS=6.0
EDGEBET_MAX_BETS_PER_DAY=6
EDGEBET_REQUIRE_SHARP_AGREEMENT=true

# Planification
EDGEBET_TIMEZONE=Europe/Paris
EDGEBET_NOTIFY_HOUR=9
EDGEBET_NOTIFY_MINUTE=0
EDGEBET_HORIZON_HOURS=36

# Base de données : vide = SQLite dans le volume data ; sinon par ex. postgresql+psycopg://user:pwd@host/edgebet
EDGEBET_DATABASE_URL=
