{
  "name": "EdgeBet – grille quotidienne",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 9 * * *" }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Chaque matin 9h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://edgebet-api:8000/api/pipeline/settle",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "REMPLACER_PAR_EDGEBET_API_KEY" }
          ]
        },
        "options": { "timeout": 300000 }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Règlement des paris passés",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://edgebet-api:8000/api/pipeline/run",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "notify", "value": "true" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "REMPLACER_PAR_EDGEBET_API_KEY" }
          ]
        },
        "options": { "timeout": 600000 }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Grille du jour + Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.warnings.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Des avertissements ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/botREMPLACER_PAR_TOKEN/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "REMPLACER_PAR_CHAT_ID" },
            { "name": "text", "value": "=⚠️ EdgeBet : {{ $json.warnings.join(' · ') }}" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Alerte Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, -100]
    }
  ],
  "connections": {
    "Chaque matin 9h": { "main": [[{ "node": "Règlement des paris passés", "type": "main", "index": 0 }]] },
    "Règlement des paris passés": { "main": [[{ "node": "Grille du jour + Telegram", "type": "main", "index": 0 }]] },
    "Grille du jour + Telegram": { "main": [[{ "node": "Des avertissements ?", "type": "main", "index": 0 }]] },
    "Des avertissements ?": { "main": [[{ "node": "Alerte Telegram", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Europe/Paris" },
  "pinData": {}
}
